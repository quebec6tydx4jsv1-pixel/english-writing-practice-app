<% if resource.errors.any? %>
  <div class="mb-6 bg-red-50 border border-red-300 rounded-lg p-4" data-turbo-temporary>
    <div class="flex items-center gap-2 mb-2">
      <span class="text-red-500 text-lg">&#9888;</span>
      <h2 class="text-red-700 font-semibold text-sm">
        <%= I18n.t("errors.messages.not_saved",
                   count: resource.errors.count,
                   resource: resource.class.model_name.human.downcase)
         %>
      </h2>
    </div>
    <ul class="space-y-1 pl-4">
      <% resource.errors.full_messages.each do |message| %>
        <li class="text-red-600 text-sm list-disc"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
