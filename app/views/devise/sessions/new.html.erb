<h1 class="text-2xl font-bold mb-6 text-center">ログイン</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white max-w-md mx-auto">

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>

    <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

    <!-- メールアドレス -->
    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block font-semibold mb-1" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "w-full border rounded p-2" %>
    </div>

    <!-- パスワード -->
    <div class="mb-6">
      <%= f.label :password, "パスワード", class: "block font-semibold mb-1" %>
      <%= f.password_field :password,
            autocomplete: "current-password",
            class: "w-full border rounded p-2" %>
    </div>

    <!-- ログインボタン -->
    <div class="flex justify-end">
      <%= f.submit "ログイン",
            class: "px-4 py-2 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm" %>
    </div>

  <% end %>

  <!-- Googleログイン -->
  <div class="mt-6">
    <div class="relative flex items-center justify-center mb-4">
      <div class="border-t w-full"></div>
      <span class="bg-white px-3 text-sm text-gray-400 absolute">または</span>
    </div>
    <%= button_to "Googleでログイン",
          user_google_oauth2_omniauth_authorize_path,
          method: :post,
          data: { turbo: false },
          class: "w-full flex items-center justify-center gap-2 px-4 py-2 border border-gray-300 rounded hover:bg-gray-50 transition text-sm text-gray-700" %>
  </div>

  <!-- 下部リンク -->
  <div class="mt-6 text-center space-y-2">
    <%= render "devise/shared/links" %>
  </div>

</div>