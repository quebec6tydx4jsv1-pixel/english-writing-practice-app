<h1 class="text-2xl font-bold mb-6 text-center">反復練習モード</h1>

<div class="max-w-2xl mx-auto bg-white p-6 rounded shadow">

  <!-- ★ 苦手表現の表示 -->
  <h2 class="text-lg font-semibold mb-2">今回使う苦手表現</h2>
  <p class="bg-red-50 text-red-600 p-3 rounded font-semibold">
    <%= @uwe.mistake.expression_text %>
  </p>

  <h2 class="text-lg font-semibold mb-2 mt-6">以下の文章を苦手表現を使って英語にしなさい</h2>
  <p class="border p-3 rounded bg-blue-50">
    <%= @review_question.question_text %>
  </p>

  <h2 class="text-lg font-semibold mt-6 mb-2">英作文入力</h2>

  <%= form_with(
      model: @review_answer,
      url: user_weak_expression_review_question_review_answer_path(@uwe, @review_question, @review_answer),
      method: :patch,
      data: { turbo: false }
    ) do |f| %>

    <%= f.text_area :review_answer_text,
          rows: 4,
          class: "w-full border rounded p-3",
          placeholder: "英作文を入力してください",
          maxlength: 120,
          id: "review-answer-text" %>
    <p class="text-right text-xs text-gray-400 mt-1">
      <span id="review-answer-count">0</span> / 120文字
    </p>

    <div class="mt-4 text-center">
      <%= f.submit "入力",
            class: "px-4 py-2 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm",
            data: { turbo: false, loading_submit: true } %>
    </div>

  <% end %>

  <script>
    document.getElementById('review-answer-text').addEventListener('input', function() {
      document.getElementById('review-answer-count').textContent = this.value.length;
    });
  </script>

  <!-- ★ 戻るボタンを追加 -->
  <div class="mt-6 text-center">
    <%= link_to "弱点一覧に戻る",
          user_weak_expressions_path,
          class: "inline-block px-4 py-2 bg-gray-100 text-gray-700 border border-gray-300 rounded hover:bg-gray-200 transition text-sm" %>
  </div>

</div>
