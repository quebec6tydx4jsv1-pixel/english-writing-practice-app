<h1 class="text-2xl font-bold mb-6 text-center">反復練習モード</h1>

<div class="max-w-2xl mx-auto bg-white p-6 rounded shadow">

  <h2 class="text-lg font-semibold mb-2">日本語</h2>
  <p class="border p-3 rounded bg-gray-50">
    <%= @review_question.question_text %>
  </p>

  <h2 class="text-lg font-semibold mt-6 mb-2">英作文入力</h2>

  <%= form_with(
      model: @review_answer,
      url: user_weak_expression_review_question_review_answers_path(@uwe),
      method: :post,
      local: true,
      data: { turbo: false }
    ) do |f| %>

    <%= f.text_area :review_answer_text,
          name: "review_answer[review_answer_text]",
          rows: 4,
          class: "w-full border rounded p-3",
          placeholder: "英作文を入力してください" %>

    <div class="mt-4 text-center">
      <%= f.submit "入力", class: "btn btn-primary" %>
    </div>

  <% end %>

</div>
