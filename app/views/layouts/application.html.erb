<!DOCTYPE html>
<html>
<head>
  <title>英作文アプリ</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- OGP 基本 -->
  <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : 'KEEP CALM AND START 英作文' %>" />
  <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : '英作文トレーニングアプリ' %>" />
  <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : image_url('ogp.png') %>" />
  <meta property="og:url" content="<%= request.original_url %>" />
  <meta property="og:type" content="website" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="<%= content_for?(:og_image) ? yield(:og_image) : image_url('ogp.png') %>" />

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", type: "module" %>
</head>

<body class="min-h-screen flex flex-col bg-gray-50">

  <!-- Header -->
  <header class="bg-white shadow">
    <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="text-2xl font-extrabold tracking-tight relative inline-block">
        <%= link_to root_path, class: "relative z-10 text-gray-800 hover:text-blue-600 transition" do %>
          英作文アプリ
        <% end %>
        <span class="absolute bottom-0 left-0 w-full h-2 bg-blue-200/40 rounded"></span>
      </div>

      <nav class="flex space-x-4">
        <%= link_to "ホーム", root_path, class: "text-gray-700 hover:text-blue-600" %>
        <% if user_signed_in? %>
          <%= link_to "英作文作成", new_question_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= link_to "苦手表現一覧", user_weak_expressions_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, form: { data: { turbo: false } }, class: "text-gray-700 hover:text-blue-600" %>
        <% else %>
          <%= link_to "新規登録", new_user_registration_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= link_to "ログイン", new_user_session_path %>
        <% end %>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="flex-1 max-w-5xl mx-auto w-full px-4 py-8">
  
  <!-- フラッシュメッセージの表示 -->
    <% flash.each do |key, value| %>
      <div class="mb-4 p-3 rounded
                  <%= key == "notice" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800" %>">
        <%= value %>
      </div>
    <% end %>

  <!-- 各ページのコンテンツ -->
    <%= yield %>
  </main>


  <!-- ローディングオーバーレイ -->
  <div id="loading-overlay" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-xl px-8 py-6 flex flex-col items-center gap-4 shadow-lg">
      <div class="w-10 h-10 border-4 border-blue-300 border-t-blue-600 rounded-full animate-spin"></div>
      <p class="text-gray-700 text-sm font-medium">AI が処理中です…</p>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t">
    <div class="max-w-5xl mx-auto px-4 py-4 flex justify-center space-x-6 text-sm text-gray-600">
      <%= link_to "利用規約", terms_path %>
      <%= link_to "プライバシーポリシー", privacy_path %>
      <%= link_to "お問い合わせ", contact_path %>
    </div>
  </footer>

</body>