<!DOCTYPE html>
<html>
<head>
  <title>Myapp</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>

<!-- Turboを無効化して、ページ遷移のたびに完全なリロードを行う -->
<body data-turbo="false" class="min-h-screen flex flex-col bg-gray-50">

  <!-- Header -->
  <header class="bg-white shadow">
    <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="text-xl font-bold">
        <%= link_to "Myapp", root_path %>
      </div>

      <nav class="flex space-x-4">
        <%= link_to "ホーム", root_path, class: "text-gray-700 hover:text-blue-600" %>
        <% if user_signed_in? %>
          <%= link_to "英作文作成", new_question_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= link_to "苦手表現一覧", user_weak_expressions_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "text-gray-700 hover:text-blue-600" %>
        <% else %>
          <%= link_to "新規登録", new_user_registration_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= link_to "ログイン", new_user_session_path %>
        <% end %>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="flex-1 max-w-5xl mx-auto w-full px-4 py-8">
  
  <!-- フラッシュメッセージの表示 -->
    <% flash.each do |key, value| %>
      <div class="mb-4 p-3 rounded
                  <%= key == "notice" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800" %>">
        <%= value %>
      </div>
    <% end %>

  <!-- 各ページのコンテンツ -->
    <%= yield %>
  </main>


  <!-- Footer -->
  <footer class="bg-white border-t">
    <div class="max-w-5xl mx-auto px-4 py-4 flex justify-center space-x-6 text-sm text-gray-600">
      <%= link_to "利用規約", terms_path %>
      <%= link_to "プライバシーポリシー", privacy_path %>
      <%= link_to "お問い合わせ", contact_path %>
    </div>
  </footer>

</body>