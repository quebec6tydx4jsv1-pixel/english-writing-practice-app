<h1>添削結果</h1>

<div class="result-section">

  <h2>模範解答</h2>
  <div class="answer-box">
    <%= @user_answer.ai_correction&.corrected_text || "（ここに模範解答が表示されます）" %>
  </div>

  <h2>あなたの回答</h2>
  <div class="answer-box">
    <%= @user_answer.answer_text %>
  </div>

</div>

<% if user_signed_in? %>

  <div class="mistake-section">

    <h2>苦手な表現候補</h2>

    <div class="mistake-box">
      <% @mistakes.each do |mistake| %>
        <div class="mistake-row">
          <span><%= mistake.expression_text %></span>

          <button
            type="button"
            class="add-mistake-btn"
            data-expression="<%= mistake.expression_text %>"
            data-mistake-id="<%= mistake.id %>">
            ＋登録
          </button>
        </div>
      <% end %>
    </div>

    <h2>登録する苦手表現</h2>

    <%= form_with model: @user_weak_expression do |f| %>

      <%= f.hidden_field :mistake_id, id: "mistake_id_field" %> <!-- どのMistakeを登録するかを指定するためのhidden_field -->
      <%= f.text_field :expression,
        id: "weak_expression_input",
        placeholder: "登録する表現を入力" %>

      <%= f.submit "登録＆苦手表現一覧へ" %>

    <% end %>

  </div>

<% else %>

  <div class="login-section">
    <p>苦手な表現を登録する場合はログインしてください</p>

    <%= link_to "ログイン",
    new_user_session_path(return_to: request.fullpath),
    class: "btn" %>

    <p>会員登録される方はこちら</p>

    <%= link_to "新規登録", new_user_registration_path, class: "btn" %>
  </div>

<% end %>