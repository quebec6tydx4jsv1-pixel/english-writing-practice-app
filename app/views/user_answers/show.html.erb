<% content_for :og_title, "添削結果: #{@user_answer.question.input_theme}" %>
<% content_for :og_description, @user_answer.answer_text&.truncate(80) %>
<% og_text = ERB::Util.url_encode("添削結果: #{@user_answer.question.input_theme}") %>
<% content_for :og_image, "https://res.cloudinary.com/dgvkgx4dx/image/upload/w_1200,c_scale/l_text:Arial_40:#{og_text},co_rgb:ffffff,g_north_west,x_60,y_120/ogp_rf9wai" %>

<h1 class="text-2xl font-bold mb-6">添削結果</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white space-y-6">

  <!-- 問題文 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">問題文</h2>
    <p class="text-gray-800 bg-blue-50 p-3 rounded">
      <%= @user_answer.question.text %>
    </p>
  </div>

  <!-- 模範解答 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">模範解答</h2>
    <p class="text-gray-800 bg-blue-50 p-3 rounded">
      <%= @user_answer.ai_correction&.corrected_text || "（ここに模範解答が表示されます）" %>
    </p>
  </div>

  <!-- あなたの解答 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">あなたの解答</h2>
    <p class="text-gray-800 bg-blue-50 p-3 rounded">
      <%= @user_answer.answer_text %>
    </p>
  </div>

  <!-- コメント -->
  <div class="bg-blue-50 p-3 rounded">
    <h2 class="text-lg font-semibold mb-2">コメント</h2>

    <% if @user_answer.ai_correction&.feedback_json.present? %>
      <ul class="list-disc pl-6 space-y-1">
        <% @user_answer.ai_correction.feedback_json["comments"].each do |comment| %>
          <li class="text-gray-700"><%= comment %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">（コメントはまだありません）</p>
    <% end %>
  </div>

  <!-- 点数 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">点数(10点満点)</h2>
    <p class="text-gray-800 bg-blue-50 p-3 rounded">
      <%= @user_answer.ai_correction&.score || "（点数はまだありません）" %>
    </p>
  </div>

  <% if user_signed_in? %>

    <!-- 覚えたい表現候補 -->
    <div>
      <h2 class="text-lg font-semibold mb-4">
        覚えたい表現候補（選択ボタンを押すと下の登録欄に自動入力されます）
      </h2>

      <% @mistakes.each do |mistake| %>
        <div class="flex justify-between items-start border rounded p-4 mb-4 bg-white shadow-sm">

          <!-- 左側：表現・項目・理由 -->
          <div class="flex-1 space-y-2">

            <!-- 表現（赤背景） -->
            <div class="flex items-center">
              <span class="text-sm font-semibold text-gray-700 w-12 shrink-0">表現：</span>
              <span class="bg-red-50 text-red-600 px-3 py-1 rounded font-semibold">
                <%= mistake.expression_text %>
              </span>
            </div>

            <!-- 項目（category） -->
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold text-gray-700 w-12 shrink-0">項目：</span>
              <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded font-semibold">
                <%= mistake.category %>
              </span>
            </div>

            <!-- 理由（reason） -->
            <div>
              <span class="text-sm font-semibold text-gray-700 w-12 shrink-0">理由：</span>
              <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded font-semibold">
                <%= mistake.reason %>
              </span>
            </div>

          </div>

          <!-- 右側：選択ボタン（縦中央に固定） -->
          <div class="flex items-center ml-6">
            <button
              type="button"
              class="add-mistake-btn px-3 py-1 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm whitespace-nowrap"
              data-expression="<%= mistake.expression_text %>"
              data-mistake-id="<%= mistake.id %>">
              選択
            </button>
          </div>

        </div>
      <% end %>
    </div>


    <!-- 登録する苦手表現 -->
    <div>
      <h2 class="text-lg font-semibold mb-4">登録する苦手表現</h2>

      <!-- ★ 選択済みリスト（ここに JS で追加される） -->
      <div id="selected_list" class="space-y-2 mb-4"></div>

      <%= form_with model: @user_weak_expression, local: true do |f| %>

        <%= hidden_field_tag "user_weak_expression[mistake_ids]", "", id: "mistake_ids_field" %>

        <%#= f.text_field :expression,
              # id: "weak_expression_input",
              # placeholder: "登録する表現を入力",
              # class: "w-full border rounded p-2 mb-4" %>

        <div class="flex justify-end">
          <%= f.submit "登録＆苦手表現一覧へ",
                class: "px-4 py-2 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm" %>
        </div>

      <% end %>
    </div>

  <% else %>

    <!-- ログイン案内 -->
    <div class="space-y-4">

      <div class="flex items-center gap-3">
        <p class="m-0 w-[800px]">苦手な表現を登録する場合はログインしてください</p>

        <%= link_to "ログインへ進む",
              new_user_session_path(return_to: request.fullpath),
              class: "px-5 py-1 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm whitespace-nowrap" %>
      </div>

      <div class="flex items-center gap-3">
        <p class="m-0 w-[800px]">会員登録される方はこちら</p>

        <%= link_to "新規登録へ進む",
            new_user_registration_path,
            class: "px-5 py-1 border border-green-300 text-green-600 rounded hover:bg-green-50 transition text-sm whitespace-nowrap" %>
      </div>

    </div>

  <% end %>

  <!-- 次のアクション -->
  <div class="mt-6 flex justify-center gap-4">
    <%= link_to "問題文へ戻る",
          question_path(@user_answer.question),
          class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition text-sm" %>
    <%= link_to "新しい英作文テーマを作成",
          new_question_path,
          class: "px-4 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700 transition text-sm" %>
  </div>

</div>
