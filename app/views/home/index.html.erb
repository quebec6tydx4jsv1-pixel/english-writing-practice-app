<h1 class="text-2xl font-bold mb-6 text-center">トップページ</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white">

  <!-- メインビジュアル -->
  <div class="mb-6">
    <%= image_tag "top.png", class: "w-2/3 mx-auto rounded shadow" %>

  </div>

  <!-- 英作文開始ボタン -->
