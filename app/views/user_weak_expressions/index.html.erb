<h1 class="text-2xl font-bold mb-6">苦手表現一覧</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

  <% @user_weak_expressions.each do |uwe| %>

    <!-- ▼▼▼ ここから1つのカード全体（外枠） ▼▼▼ -->
    <div class="weak-expression-item border rounded-lg p-4 shadow-sm bg-white flex flex-col">

      <!-- 弱点表現（英語フレーズを強調） -->
      <p class="font-bold text-2xl leading-tight tracking-wide font-sans">
        <%= uwe.mistake.expression_text %>
      </p>

      <!-- メモ表示（空欄でも表示） -->
      <div class="mt-3 p-2 bg-gray-50 rounded text-sm text-gray-700 leading-relaxed min-h-[60px]">
        <%= uwe.note.presence || "（メモはまだありません）" %>
      </div>

      <!-- メモ更新フォーム -->
      <%= form_with model: uwe,
                    url: user_weak_expression_path(uwe),
                    method: :patch,
                    data: { turbo: false },
                    class: "mt-4" do |f| %>

        <%= f.text_area :note,
              rows: 3,
              class: "w-full border rounded p-3 text-sm leading-normal resize-none" %>

        <!-- メモ欄を編集（セカンダリ操作） -->
        <div class="flex justify-end mt-2">
          <%= f.submit "メモ欄を編集",
                class: "px-3 py-1 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-xs" %>
        </div>

      <% end %>

      <!-- ▼ 反復練習ボタン（位置変更・見た目変更） -->
      <div class="flex justify-end mt-2">
        <%= link_to "反復練習する",
            user_weak_expression_review_questions_path(uwe),
            data: { turbo_method: :post },
            class: "review-practice-link px-3 py-1 border border-green-300 text-green-600 rounded hover:bg-green-50 transition text-xs" %>
      </div>

      <!-- 苦手表現を削除（form の外に出す） -->
      <div class="flex justify-end mt-2">
        <%= button_to "苦手表現を削除",
              user_weak_expression_path(uwe),
              method: :delete,
              form: { data: { turbo: false } },
              data: { confirm: "本当に削除しますか？" },
              class: "px-3 py-1 border border-gray-300 text-red-500 rounded hover:bg-gray-50 transition text-xs" %>
      </div>

    </div>
    <!-- ▲▲▲ ここまでが1つのカード全体（外枠） ▲▲▲ -->

  <% end %>

</div>
