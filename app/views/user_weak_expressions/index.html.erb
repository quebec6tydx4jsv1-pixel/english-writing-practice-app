<h1 class="text-2xl font-bold mb-6">苦手表現一覧</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

  <% @user_weak_expressions.each do |uwe| %>

    <div class="weak-expression-item border rounded-lg p-4 shadow-sm bg-white flex flex-col justify-between mb-4">

      <!-- 弱点表現 -->
      <p class="font-semibold text-lg"><%= uwe.mistake.expression_text %></p>

      <!-- 反復練習ボタン（カード上部に近い位置） -->
      <%= link_to "反復練習する",
          user_weak_expression_review_question_path(uwe),
          class: "review-practice-link text-blue-600 hover:underline mt-2" %>

      <!-- メモ更新フォーム（カード下部） -->
      <%= form_with model: uwe,
                    url: user_weak_expression_path(uwe),
                    method: :patch,
                    class: "mt-4" do |f| %>

        <%= f.text_area :note,
              rows: 2,
              class: "w-full border rounded p-2 text-sm" %>

        <%= f.submit "更新",
              class: "mt-2 text-blue-600 hover:underline text-sm" %>

      <% end %>

      <!-- 削除ボタン（更新の下に配置） -->
      <%= button_to "削除",
            user_weak_expression_path(uwe),
            method: :delete,
            data: { turbo: false, confirm: "本当に削除しますか？" },
            class: "text-red-500 hover:underline text-sm mt-2" %>

    </div>

  <% end %>

</div>
