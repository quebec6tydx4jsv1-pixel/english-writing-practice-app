<h1 class="text-center my-6 text-2xl font-bold">苦手表現一覧</h1>

<% if @user_weak_expressions.any? %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-4">

    <% @user_weak_expressions.each do |uwe| %>

      <!-- Cypress が「1つの弱点」を特定できるようにクラスを付与 -->
      <div class="weak-expression-item border rounded-lg p-4 shadow-sm bg-white flex flex-col justify-between">

        <!-- 表示しているミスの内容 -->
        <p class="font-semibold text-lg"><%= uwe.mistake.expression_text %></p>

        <!-- 反復練習リンク：Cypress が確実にクリックできるようにクラスを付与 -->
        <%= link_to "反復練習する",
            user_weak_expression_review_question_path(uwe),
            class: "review-practice-link text-blue-500 hover:underline mt-2" %>

        <!-- メモ編集フォーム（既存のまま） -->
        <%= form_with model: uwe,
                      url: user_weak_expression_path(uwe),
                      method: :patch,
                      class: "mt-2" do |f| %>

          <%= f.text_area :note,
                rows: 2,
                class: "w-full border rounded p-2 text-sm" %>

          <%= f.submit "更新",
                class: "mt-2 text-blue-500 hover:underline text-sm" %>

        <% end %>

        <%= button_to "削除",
              user_weak_expression_path(uwe),
              method: :delete,
              data: { turbo: false, confirm: "本当に削除しますか？" },
              class: "text-red-500 hover:underline text-sm mt-2" %>

      </div>

    <% end %>

  </div>

<% else %>

  <p class="text-center text-gray-500 mt-6">
    まだ登録されている苦手表現はありません。
  </p>

<% end %>

<div class="text-center mt-8">
  <%= link_to "新しい苦手表現を登録",
      new_question_path,
      class: "btn btn-primary" %>
</div>
