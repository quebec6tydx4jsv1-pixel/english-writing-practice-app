<h1>英作文入力</h1>

<div>
  <label>日本語</label>
  <p><%= @question.text %></p>
</div>

<div>
  <label>英作文入力</label>

  <%= form_with model: UserAnswer.new, url: user_answers_path do |f| %>

    <%= f.hidden_field :question_id, value: @question.id %>

    <%= f.text_area :answer_text, rows: 6 %>

    <%= f.submit "入力" %>

  <% end %>

</div>