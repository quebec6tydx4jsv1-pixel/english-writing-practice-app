<% content_for :og_title, "英作文練習: #{@question.input_theme}" %>
<% content_for :og_description, @question.text&.truncate(80) %>
<% og_text = ERB::Util.url_encode("英作文練習: #{@question.input_theme}") %>
<% content_for :og_image, "https://res.cloudinary.com/dgvkgx4dx/image/upload/w_1200,c_scale/l_text:Arial_40:#{og_text},co_rgb:ffffff,g_west,x_60/ogp_rf9wai" %>

<h1 class="text-2xl font-bold mb-6">英作文入力</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white space-y-6">

  <!-- 日本語の問題文 -->
  <div>
    <label class="block font-semibold mb-1">日本語</label>
    <p class="p-3 border rounded bg-gray-50">
      <%= @question.text %>
    </p>
  </div>

  <!-- 英作文入力フォーム -->
  <div>
    <label class="block font-semibold mb-1">英作文入力</label>

    <%= form_with model: UserAnswer.new, url: user_answers_path, local: true do |f| %>

      <%= f.hidden_field :question_id, value: @question.id %>

      <%= f.text_area :answer_text,
            rows: 6,
            placeholder: "ここに英作文を入力してください",
            maxlength: 120,
            id: "answer-text",
            class: "w-full border rounded p-2 mb-1" %>
      <p class="text-right text-xs text-gray-400 mb-3">
        <span id="answer-count">0</span> / 120文字
      </p>

      <div class="flex justify-end">
        <%= f.submit "入力",
              class: "px-4 py-2 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm" %>
      </div>

    <% end %>
  </div>

</div>

<script>
  document.getElementById('answer-text').addEventListener('input', function() {
    document.getElementById('answer-count').textContent = this.value.length;
  });
</script>
