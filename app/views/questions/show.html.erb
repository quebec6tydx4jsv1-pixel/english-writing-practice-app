<h1 class="text-2xl font-bold mb-6">英作文入力</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white space-y-6">

  <!-- 日本語の問題文 -->
  <div>
    <label class="block font-semibold mb-1">日本語</label>
    <p class="p-3 border rounded bg-gray-50">
      <%= @question.text %>
    </p>
  </div>

  <!-- 英作文入力フォーム -->
  <div>
    <label class="block font-semibold mb-1">英作文入力</label>

    <%= form_with model: UserAnswer.new, url: user_answers_path, local: true do |f| %>

      <%= f.hidden_field :question_id, value: @question.id %>

      <%= f.text_area :answer_text,
            rows: 6,
            placeholder: "ここに英作文を入力してください",
            class: "w-full border rounded p-2 mb-4" %>

      <div class="flex justify-end">
        <%= f.submit "入力",
              class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition inline-flex items-center text-sm" %>
      </div>

    <% end %>
  </div>

</div>
