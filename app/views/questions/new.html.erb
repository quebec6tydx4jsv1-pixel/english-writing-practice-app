<h1 class="text-2xl font-bold mb-6">英作文テーマ入力</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white">

  <%= form_with model: Question.new, local: true do |f| %>

    <!-- テーマ -->
    <div class="mb-4">
      <label class="block font-semibold mb-1">テーマ</label>
      <%= f.text_field :input_theme,
            placeholder: "例：趣味、日常生活、旅行、仕事など",
            maxlength: 10,
            data: { counter_target: "theme" },
            class: "w-full border rounded p-2" %>
      <p class="text-right text-xs text-gray-400 mt-1">
        <span id="theme-count">0</span> / 10文字
      </p>
    </div>

    <!-- 具体的な状況 -->
    <div class="mb-6">
      <label class="block font-semibold mb-1">具体的な状況など</label>
      <%= f.text_area :input_situation,
            rows: 5,
            placeholder: "例：昨日の夜、友達と映画を見に行った場面など",
            maxlength: 60,
            data: { counter_target: "situation" },
            class: "w-full border rounded p-2" %>
      <p class="text-right text-xs text-gray-400 mt-1">
        <span id="situation-count">0</span> / 60文字
      </p>
    </div>

    <!-- 右寄せの入力ボタン -->
    <div class="flex justify-end">
      <%= f.submit "入力",
            class: "px-4 py-2 border border-blue-300 text-blue-600 rounded hover:bg-blue-50 transition text-sm",
            data: { loading_submit: true } %>
    </div>

  <% end %>

</div>

<script>
  document.querySelector('[data-counter-target="theme"]').addEventListener('input', function() {
    document.getElementById('theme-count').textContent = this.value.length;
  });
  document.querySelector('[data-counter-target="situation"]').addEventListener('input', function() {
    document.getElementById('situation-count').textContent = this.value.length;
  });
</script>
