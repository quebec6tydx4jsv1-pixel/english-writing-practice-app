<h1 class="text-2xl font-bold mb-6">反復練習添削結果</h1>

<div class="border rounded-lg p-6 shadow-sm bg-white space-y-6">

  <!-- 模範解答 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">模範解答</h2>
    <p class="text-gray-800 bg-blue-50 p-3 rounded">
      <%= @review_answer.ai_correction.corrected_text %>
    </p>
  </div>

  <!-- あなたの解答 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">あなたの解答</h2>
    <p class="text-gray-800 bg-blue-50 p-3 rounded">
      <%= @review_answer.answer_text %>
    </p>
  </div>

  <!-- 克服した表現 -->
  <div>
    <h2 class="text-lg font-semibold mb-2">克服した表現</h2>
    <p class="bg-red-50 text-red-600 p-3 rounded">
      <%= @uwe.mistake.expression_text %>
    </p>
  </div>

  <!-- 登録解除ボタン（白背景＋赤文字＋赤枠線） -->
  <div class="mt-6 flex justify-end">
    <%= button_to "登録解除",
          user_weak_expression_path(@uwe),
          method: :delete,
          class: "px-4 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 transition text-sm" %>
  </div>

  <!-- 弱点一覧に戻る（白背景＋緑文字＋緑枠線） -->
  <div class="mt-2 flex justify-end">
    <%= link_to "弱点一覧に戻る",
        user_weak_expressions_path,
        class: "px-4 py-2 border border-green-300 text-green-600 rounded hover:bg-green-50 transition text-sm inline-flex items-center" %>
  </div>

</div>
